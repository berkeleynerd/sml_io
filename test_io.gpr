with "sml.gpr";
with "sml_io.gpr";

project Test_IO is

   for Source_Dirs use ("test/");
   for Object_Dir use "obj/test/";
   for Exec_Dir use "bin/";
   for Main use ("test_io.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Test_IO;
