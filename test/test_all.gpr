with "sml.gpr";
with "../sml_io.gpr";

project Test_All is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/test/";
   for Exec_Dir use "../bin/";
   for Create_Missing_Dirs use "True";

   --  Keep existing main procedure name
   for Main use ("test_io.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",      --  Ada 2022 mode
         "-gnatwa");       --  All warnings
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use (
         "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
         "-Wl,-stack_size,0x8000000");
   end Linker;

end Test_All;
